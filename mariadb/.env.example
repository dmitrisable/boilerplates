# --- MariaDB core ---
MARIADB_VERSION=11
CONTAINER_NAME=mariadb
MARIADB_ROOT_PASSWORD=change-me-strong-root-password
MARIADB_DATABASE=app
MARIADB_USER=app
MARIADB_PASSWORD=change-me-strong-password
MARIADB_PORT=3306
TZ=UTC

# --- Tuning ---
MARIADB_MAX_CONNECTIONS=151
MARIADB_INNODB_BUFFER_POOL_SIZE=256M

# --- Resource limits ---
MARIADB_CPU_LIMIT=2
MARIADB_MEM_LIMIT=1g

# --- Optional phpMyAdmin (enable with: docker compose --profile tools up -d) ---
PHPMYADMIN_PORT=8081
PHPMYADMIN_VERSION=latest
PHPMYADMIN_UPLOAD_LIMIT=64M
