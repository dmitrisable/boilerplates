# --- Postgres core ---
POSTGRES_VERSION=18-alpine
CONTAINER_NAME=postgres18
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=app
POSTGRES_PORT=5432
TZ=UTC

# --- Resource limits ---
POSTGRES_CPU_LIMIT=2
POSTGRES_MEM_LIMIT=2g

# --- Optional pgAdmin (enable with: docker compose --profile tools up -d) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-strong-password
PGADMIN_PORT=5050
PGADMIN_VERSION=latest
