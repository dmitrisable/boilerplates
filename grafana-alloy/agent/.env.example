CONTAINER_NAME=alloy-agent
TZ=UTC
ALLOY_VERSION=latest
ALLOY_UI_PORT=12345
ALLOY_CPU_LIMIT=0.5
ALLOY_MEM_LIMIT=256m

# Переопределить имя хоста в лейблах метрик (по умолчанию берётся HOSTNAME)
HOSTNAME_OVERRIDE=

# Адрес центрального Alloy (см. grafana-alloy/server)
CENTRAL_REMOTE_WRITE_URL=http://<central-alloy-host>:9999/api/v1/metrics/write
CENTRAL_LOKI_PUSH_URL=http://<central-alloy-host>:3100/loki/api/v1/push
CENTRAL_BASIC_AUTH_USERNAME=
CENTRAL_BASIC_AUTH_PASSWORD=
