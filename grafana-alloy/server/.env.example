# --- Общие ---
CONTAINER_NAME=grafana-alloy
TZ=UTC

# --- Alloy ---
ALLOY_VERSION=latest
ALLOY_UI_PORT=12345
ALLOY_REMOTE_WRITE_PORT=9999
ALLOY_LOKI_PORT=3100
ALLOY_OTLP_GRPC_PORT=4317
ALLOY_OTLP_HTTP_PORT=4318
ALLOY_CPU_LIMIT=1
ALLOY_MEM_LIMIT=512m

# Backend, куда центральный Alloy пересылает данные.
# Это может быть self-hosted Mimir/Loki или Grafana Cloud.
REMOTE_WRITE_URL=https://<your-mimir-or-cloud>/api/v1/push
REMOTE_WRITE_USERNAME=
REMOTE_WRITE_PASSWORD=

LOKI_PUSH_URL=https://<your-loki-or-cloud>/loki/api/v1/push
LOKI_USERNAME=
LOKI_PASSWORD=

# --- Grafana ---
GRAFANA_VERSION=latest
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
GF_SERVER_ROOT_URL=http://localhost:3000
GF_INSTALL_PLUGINS=
GRAFANA_CPU_LIMIT=1
GRAFANA_MEM_LIMIT=512m

# Датасорсы Grafana (обычно совпадают с query-эндпоинтами того же backend,
# что указан выше для Alloy)
METRICS_DATASOURCE_URL=https://<your-mimir-or-cloud>/prometheus
METRICS_DATASOURCE_USER=
METRICS_DATASOURCE_PASSWORD=

LOGS_DATASOURCE_URL=https://<your-loki-or-cloud>
LOGS_DATASOURCE_USER=
LOGS_DATASOURCE_PASSWORD=
